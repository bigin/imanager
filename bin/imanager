#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

if (! class_exists(\Imanager\Cli\Application::class)) {
    fwrite(\STDERR, "iManager autoload not found. Run `composer install` first.\n");
    exit(1);
}

exit((new \Imanager\Cli\Application())->run());
